{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/MemMori1/llm-odds/schemas/ask.response.v1.schema.json",
  "title": "llm-odds ask response (v1)",
  "description": "单题响应（成功与失败同构：ok=false 时给 error）。ask_many 的 results 元素与此同构。",
  "type": "object",
  "required": ["v", "ok"],
  "properties": {
    "v": {"const": 1},
    "id": {"type": "string"},
    "ok": {"type": "boolean"},
    "task": {"enum": ["choice", "noul", "score"]},
    "probs": {
      "description": "归一化概率分布（∑p = 1）。",
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "ranked": {
      "description": "按概率降序。",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "p"],
        "properties": {
          "id": {"type": "string"},
          "p": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "choice": {"type": ["string", "null"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "noul": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "score": {"type": ["number", "null"]},
    "warnings": {
      "description": "missing_letters / truncated_options / low_signal（见 DESIGN.md §5.2）。",
      "type": "array",
      "items": {"type": "string"}
    },
    "model": {
      "description": "最终生效的模型参数（回显，可审计）。",
      "type": "object",
      "properties": {
        "profile": {"type": "string"},
        "backend": {"type": "string"},
        "name": {"type": "string"},
        "size": {"type": "string"},
        "temperature": {"type": "number"},
        "top_k": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "properties": {
        "elapsed_ms": {"type": "number", "minimum": 0},
        "tokens_evaluated": {"type": "integer", "minimum": 0},
        "missing_letters": {"type": "integer", "minimum": 0},
        "truncated": {"type": "integer", "minimum": 0},
        "cache": {"enum": ["hit", "miss", "off"]},
        "attempts": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "raw": {
      "description": "include_raw=true 时给出原始 logprobs。",
      "type": "object",
      "properties": {
        "logprobs": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": ["object", "null"],
      "required": ["code"],
      "properties": {
        "code": {
          "enum": ["bad_request", "unknown_profile", "model_unavailable",
                   "logprobs_unavailable", "timeout", "no_options", "internal"]
        },
        "message": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
